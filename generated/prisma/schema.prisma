generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator prismabox {
  provider                    = "prismabox"
  typeboxImportDependencyName = "elysia"
  typeboxImportVariableName   = "t"
  inputModel                  = true
  output                      = "../generated/prismabox"
}

model AppUser {
  userId           Int      @id @default(autoincrement())
  userName         String   @unique @db.VarChar(50)
  email            String   @unique @db.VarChar(100)
  password         String   @db.VarChar(255)
  fullName         String   @db.VarChar(100)
  mobileNo         String?  @db.VarChar(15)
  isActive         Boolean  @default(false)
  isAdmin          Boolean  @default(false)
  isLimitDevices   Boolean  @default(false)
  limitDeviceCount Int?     @default(0)
  profilePic       String?  @db.VarChar(255)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MenuList {
  menuId    Int      @id @default(autoincrement())
  menuName  String   @db.VarChar(100)
  menuIcon  String   @db.VarChar(100)
  sorting   Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  SubMenu SubMenu[]
}

model SubMenu {
  subMenuId    Int      @id @default(autoincrement())
  menuId       Int
  subMenuName  String   @db.VarChar(100)
  subMenuIcon  String   @db.VarChar(100)
  subMenuRoute String   @db.VarChar(200)
  sorting      Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  menuList MenuList @relation(fields: [menuId], references: [menuId])
}

model Department {
  departmentId   Int      @id @default(autoincrement())
  departmentName String   @db.VarChar(100)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Employee Employee[]
}

model Employee {
  employeeId   Int       @id @default(autoincrement())
  namePrefix   String?   @db.VarChar(20)
  firstName    String    @db.VarChar(60)
  lastName     String    @db.VarChar(60)
  email        String?   @unique @db.VarChar(100)
  phoneNumber  String?   @db.VarChar(15)
  hireDate     DateTime?
  jobTitle     String?   @db.VarChar(100)
  departmentId Int
  birthDate    DateTime?
  idCardNumber String?   @db.VarChar(50)
  address      String?   @db.VarChar(255)
  salary       Float?    @default(0)
  remarks      String?   @db.VarChar(300)
  isWorking    Boolean   @default(true)
  empPicture   String?   @db.VarChar(255)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  department Department @relation(fields: [departmentId], references: [departmentId])
}

model Customer {
  customerId   Int      @id @default(autoincrement())
  customerName String   @db.VarChar(100)
  contactName  String?  @db.VarChar(100)
  address      String?  @db.VarChar(255)
  city         String?  @db.VarChar(50)
  postalCode   String?  @db.VarChar(20)
  country      String   @default("Thailand") @db.VarChar(50)
  phone        String?  @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ProductType {
  productTypeId   Int      @id @default(autoincrement())
  productTypeName String   @db.VarChar(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model MetalType {
  metalTypeId   Int      @id @default(autoincrement())
  metalTypeName String   @db.VarChar(100)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UnitType {
  unitTypeId   Int      @id @default(autoincrement())
  unitTypeName String   @db.VarChar(100)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model JobOrder {
  jobOrderId         Int       @id @default(autoincrement())
  jobOrderNumber     String    @unique @db.VarChar(50)
  customerId         Int
  jobDate            DateTime?
  customerBillNumber String?   @db.VarChar(50)
  customerBillItemNo Int?
  productTypeId      Int
  metalTypeId        Int
  qty                Int       @default(1)
  unitTypeId         Int
  weight             Float?    @default(0)
  dueDate            DateTime?
  billPicture        String?   @db.VarChar(255)
  status             String    @default("") @db.VarChar(5)
  remarks            String?   @db.VarChar(300)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
